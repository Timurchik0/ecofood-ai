# --- обязательно на Vercel ---
# Postgres. Подставляется автоматически, если подключить Neon через Vercel → Storage.
# Локально можно не задавать: тогда используется встроенная БД PGlite (папка .data).
DATABASE_URL=

# Ключ входа на страницу /admin (настройки скоринга, контакты, импорт). Любая длинная строка.
ADMIN_KEY=

# Секрет для приёма ответов из Google Apps Script (заголовок x-intake-secret). Любая длинная строка.
INTAKE_SECRET=

# --- по желанию ---
# Включает AI-заметки (без ключа заметки строятся по шаблону на тех же баллах).
ANTHROPIC_API_KEY=
# Модель по умолчанию: claude-opus-5-5. Подойдут также claude-sonnet-5-5 и claude-haiku-4-5.
ANTHROPIC_MODEL=
# 1 = AI выключен, даже если ключ задан.
AI_DISABLED=

# 1 = в демо статусы CRM и заметки может менять только админ (по умолчанию — любой посетитель).
DEMO_READONLY=

# Ссылка на Google-таблицу с ответами (CSV). То же можно задать на странице /admin.
GOOGLE_SHEET_URL=
